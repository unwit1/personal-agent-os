    {
      "id": "AIT-0061",
      "name": "Narrow task-oriented tools",
      "aliases": [],
      "category": "tool_design",
      "layer": [
        "tools",
        "agents"
      ],
      "goal": "Improve tool selection and reduce agent computation",
      "mechanism": "Expose tools around meaningful user/task primitives rather than raw low-level APIs or overly broad mega-tools.",
      "maturity": "production_pattern",
      "evidence": {
        "strength": "high",
        "summary": "Evidence basis: SRC-AI-0071, SRC-AI-0096.",
        "limitations": []
      },
      "agent_os_fit": "core",
      "agent_os_pattern": "Mine traces to merge/split tools based on confusion and repeated sequences.",
      "use_when": [
        "Repeated workflows",
        "Large service APIs"
      ],
      "avoid_when": [
        "Low-level primitive is itself the stable contract"
      ],
      "required_evals": [
        "tool-selection accuracy",
        "argument errors",
        "calls/task"
      ],
      "risks": [
        "Too many tiny tools can also confuse model"
      ],
      "cost_profile": "usually lowers context/model work",
      "complexity": "medium",
      "dependencies": [],
      "sources": [
        "SRC-AI-0071",
        "SRC-AI-0096"
      ],
      "keywords": [
        "tool_granularity"
      ],
      "notes": ""
    },
