    {
      "id": "AIT-0256",
      "name": "Semantic-entropy uncertainty",
      "aliases": [],
      "category": "uncertainty",
      "layer": [
        "evaluation",
        "inference"
      ],
      "goal": "Detect confabulation-prone questions/claims via variation in meaning across samples",
      "mechanism": "Sample multiple outputs, cluster semantically equivalent meanings, compute entropy over meaning clusters and abstain/escalate when high.",
      "maturity": "replicated_research",
      "evidence": {
        "strength": "high",
        "summary": "Evidence basis: SRC-AI-0227.",
        "limitations": []
      },
      "agent_os_fit": "conditional",
      "agent_os_pattern": "Potential uncertainty signal, never sole correctness oracle.",
      "use_when": [
        "High-value factual claims without easy oracle",
        "Uncertainty-triggered retrieval"
      ],
      "avoid_when": [
        "Simple task with deterministic verifier",
        "Latency-sensitive low-risk calls"
      ],
      "required_evals": [
        "AUROC/AURAC",
        "cost",
        "abstention utility"
      ],
      "risks": [
        "Multi-sample cost",
        "semantic clustering errors",
        "does not detect all hallucinations"
      ],
      "cost_profile": "multiple generations + entailment",
      "complexity": "high",
      "dependencies": [],
      "sources": [
        "SRC-AI-0227"
      ],
      "keywords": [
        "semantic_entropy",
        "confabulation"
      ],
      "notes": ""
    },
