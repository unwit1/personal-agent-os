    {
      "id": "AIT-0031",
      "name": "Lexical/BM25 retrieval",
      "aliases": [],
      "category": "retrieval",
      "layer": [
        "retrieval"
      ],
      "goal": "Retrieve exact terminology, identifiers and rare strings efficiently",
      "mechanism": "Use sparse term-frequency/inverse-document-frequency ranking such as BM25.",
      "maturity": "foundational",
      "evidence": {
        "strength": "high",
        "summary": "Evidence basis: SRC-AI-0072.",
        "limitations": []
      },
      "agent_os_fit": "core",
      "agent_os_pattern": "Keep as first-class route; not everything needs embeddings.",
      "use_when": [
        "Exact names",
        "Error messages",
        "IDs",
        "Policy phrases"
      ],
      "avoid_when": [
        "Pure semantic paraphrase with little lexical overlap"
      ],
      "required_evals": [
        "recall@k",
        "MRR",
        "latency"
      ],
      "risks": [
        "Vocabulary mismatch"
      ],
      "cost_profile": "very low",
      "complexity": "low",
      "dependencies": [],
