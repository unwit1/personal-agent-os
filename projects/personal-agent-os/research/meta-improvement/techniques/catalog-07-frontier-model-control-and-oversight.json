      "category": "reasoning_training",
      "layer": [
        "training",
        "evaluation",
        "reasoning"
      ],
      "goal": "Reward correct intermediate reasoning rather than only final answer",
      "mechanism": "Collect or infer step-level correctness labels and train a process reward/verifier model that scores intermediate steps.",
      "maturity": "replicated_research",
