        "strength": "high",
        "summary": "Evidence basis: SRC-AI-0154, SRC-AI-0183, SRC-AI-0160.",
        "limitations": []
      },
      "agent_os_fit": "research_only",
      "agent_os_pattern": "Near-term lesson is architectural: verify observable intermediate artifacts/states, not hidden reasoning.",
