      "id": "AIT-0121",
      "name": "Training-data exact/near deduplication",
      "aliases": [],
      "category": "data_quality",
      "layer": [
        "data",
        "training"
      ],
      "goal": "Reduce memorization, train-test leakage and wasted training compute",
      "mechanism": "Remove exact/near duplicate sequences/documents and explicitly decontaminate evaluation sets.",
      "maturity": "replicated_research",
      "evidence": {
        "strength": "high",
        "summary": "Evidence basis: SRC-AI-0116.",
        "limitations": []
      },
      "agent_os_fit": "conditional",
      "agent_os_pattern": "General principle also applies to Agent OS knowledge/context candidate stores.",
      "use_when": [
        "Any local model training/fine-tuning corpus",
        "Synthetic data generation"
      ],
      "avoid_when": [
        "Tiny intentionally repeated curriculum where repetition is controlled"
      ],
      "required_evals": [
        "memorization",
        "held-out accuracy",
        "steps-to-target",
        "contamination"
      ],
      "risks": [
        "Over-aggressive dedupe removes legitimate repeated forms"
      ],
      "cost_profile": "preprocessing saves training compute",
      "complexity": "medium",
      "dependencies": [],
      "sources": [
        "SRC-AI-0116"
      ],
      "keywords": [
        "dedupe",
        "decontamination"
      ],
      "notes": ""
    },
