    {
      "id": "AIT-0001",
      "name": "Direct goal + explicit success criteria",
      "aliases": [],
      "category": "prompt_design",
      "layer": [
        "prompt",
        "reasoning"
      ],
      "goal": "Improve instruction following with minimal prompt overhead",
      "mechanism": "State the objective, hard constraints, definition of done, and output contract directly rather than prescribing unnecessary internal reasoning.",
      "maturity": "production_pattern",
      "evidence": {
        "strength": "high",
        "summary": "Evidence basis: SRC-AI-0065, SRC-AI-0066.",
        "limitations": []
      },
      "agent_os_fit": "core",
      "agent_os_pattern": "Default prompt skeleton for Agent OS stages.",
      "use_when": [
        "Most Agent OS tasks",
        "Reasoning-capable models"
      ],
      "avoid_when": [
        "When a domain needs worked examples or specialized procedure"
      ],
      "required_evals": [
        "task success",
        "constraint adherence",
        "token cost"
      ],
      "risks": [
        "Under-specification if success criteria are incomplete"
      ],
      "cost_profile": "very low; often reduces tokens",
      "complexity": "very_low",
      "dependencies": [],
      "sources": [
        "SRC-AI-0065",
        "SRC-AI-0066"
      ],
      "keywords": [
        "goal",
        "constraints",
        "definition_of_done"
      ],
      "notes": ""
    },
