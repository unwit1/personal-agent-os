":null,"dialogue_topic_source_id":"Glenmoril.esm:0CB214","dialogue_topic_observed_form_id":"040CB214","dialogue_topic_editor_id":null,"dialogue_prompt":null,"info_records":[{"info_source_id":"Glenmoril.esm:0CB215","info_observed_form_id":"040CB215","response_texts":["But soon you will be born from the loins of that man-cat. Bleeding and lost, you will know Love, but you will lose everything that brought you here."]}]}]}
