{"source_file":"WheelsOfLull.esp","source_sha256":"230b102cd1ec13f2d104da8803d32c19227ef519eaca766a00b076c322aa78bb","record_type":"QUST","form_id":"05039182","editor_id":"_Lull_SQ_Wailway","full_name":"Working on the Wailway","source_offset":4191046,"provenance_status":"direct_plugin_record","continuity_id":"tes.mod.wheels-of-lull","stages":[{"index":0,"log_entries":[]},{"index":10,"log_entries":["After overcoming the Cartwright, I discovered another disused tram, but the entrance is blocked off and the access console is inoperable. I'll need to find a way to repair Lull-Mor's diagnostic systems before I can use the console.  "]},{"index":11,"log_entries":["With Medeliu Hammar's \"assistance,\" I've repaired Lull-Mor's monitors. The tram's access console should be working now. "]},{"index":20,"log_entries":["After overcoming the Cartwright, I discovered another disused tram. With the the barrier disabled, I may as well see where it goes. "]},{"index":30,"log_entries":["I've arrived in another strange place. I suppose I should see what the giant screaming face up ahead wants?"]},{"index":60,"log_entries":["I've encountered a suicidal train from the Reman era trapped in this disused wailway station. It wants my help to find a way to destroy it and release its spirit. "]},{"index":90,"log_entries":["Destroying the train has released the soul trapped within. I should speak with him before he departs."]},{"index":100,"log_entries":["I've dropped the train into the wailway's crusher machine, releasing the soul trapped within the train's workings. That was disturbing. "]}],"objectives":[{"index":10,"text":"Repair Lull-Mor's Monitoring System","targets":["0100000000000000"]},{"index":11,"text":"Return to the Access Console","targets":["0000000000000000"]},{"index":20,"text":"Board the Tram","targets":[]},{"index":30,"text":"Speak with the Wailway Engine","targets":["0300000000000000"]},{"index":60,"text":"Find a way to destroy the train","targets":[]},{"index":90,"text":"Speak with the freed soul","targets":[]}],"vmad_present":true}
