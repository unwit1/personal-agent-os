{"ordinal":2447,"form_id":"01011B39","editor_id":"ZOSaBookDUPLICATE2122","title":"Notes on Elven Architecture","text_sha256":"5f22aae71d86bd06e5b2196402c8e6e4312d45266e2b5071ebc29b44f2ba4b49","analysis_version":"eso-books-first-pass-v1","provenance_status":"eso_derived_compilation_pending_individual_verification","document_type":"other","epistemic_mode":"source_statement_unclassified","topic_tags":["altmer_summerset","argonian_hist","ayleid","reachfolk","imperial_cyrodiil","war_politics","history_chronicle"],"candidate_entities":["Architecture","Elven","Notes","Altmer","High","Congonius of Skingrad","Altmeri and Ayleid","Where the Ayleids","Historian","Summerset","Cantaber","Gastinus","Imperial","Reachmen","Skywatch","Auridon","Soaring","Ayleid","Bravil","Florus"],"claim_seeds":[{"evidence_sha256":"4894f56e561fcef4149008854ce22543eca5899f810eba673134192060b8d68a","evidence_preview":"Subtle changes are less obvious: while the Altmer are snobbish, they never sank to Ayleid levels of perniciousness, and the more refined buildings of Auridon reflect this.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"f99f2fd749c0ebade7119bc72497b3da916215febdbc90e6e9a72ac7ce0bcb04","evidence_preview":"The Altmer seek refinement rather than innovation, and they are conceitedly resistant to large-scale changes but are content to tinker.","promotion_status":"candidate_only_requires_review"}],"review_status":"first_pass_complete_claims_unpromoted"}
{"ordinal":2448,"form_id":"01012CC4","editor_id":"ZOSaBookDUPLICATE2478","title":"Notes on Klathzgar's Schematics","text_sha256":"8dd82d9d6692005d5574c34f264025229c864280a8048aa7a0d46d0f60253aca","analysis_version":"eso-books-first-pass-v1","provenance_status":"eso_derived_compilation_pending_individual_verification","document_type":"other","epistemic_mode":"source_statement_unclassified","topic_tags":["dwemer","altmer_summerset"],"candidate_entities":["Klathzgar's","Schematics","Klathzgar","Notes","Uurthehnchenthyalft","Distressingly","Translating","Pelorrah","Urenenya","Altmer","Dwemer","Some"],"claim_seeds":[{"evidence_sha256":"332e58397cc55b9375be824748ff894cc34c1ec67335b6e17e29ec2d9fc89cf6","evidence_preview":"It seems Klathzgar was building a very special centurion as a gift, or something similar.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"d25fa1d9681349795af3555127d8014c95405d7afbe383b4d7b45abd3491a9f9","evidence_preview":"Of greatest interest is the name \"\"Uurthehnchenthyalft,\"\" which would roughly translate to \"\"Urenenya.\"\" This means I have definitely come to the right place!","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"7c2646f3e8778c73508482f0943daf1fd25dc2f625f39cfeb6236c438029a4c8","evidence_preview":"Distressingly, however, the brazen automatons of Klathzgar's workshop, which were initially quiescent, have begun to twitch and quiver.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"cb2935a8a39d09a72175b613ecd98aab484fcead44f240150f28a5fbbc4dfb1e","evidence_preview":"Some of their crystalline studs are glowing as well, and their armatures occasionally emit puffs of steam.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"db1aae1e7290d0a6701c1708d80a3c11ba762e1203905fbec69fabf4b4736468","evidence_preview":"If I were not an Altmer of proud and impeccable lineage, I would admit to some anxiety.","promotion_status":"candidate_only_requires_review"}],"review_status":"first_pass_complete_claims_unpromoted"}
{"ordinal":2449,"form_id":"01012F7E","editor_id":"ZOSaBookDUPLICATE3176","title":"Notes on Orichalcum","text_sha256":"d3a36a072b436b30397a396fbc2cbbed3210e8517e00f12a9f7c21e40fe468b0","analysis_version":"eso-books-first-pass-v1","provenance_status":"eso_derived_compilation_pending_individual_verification","document_type":"other","epistemic_mode":"source_statement_unclassified","topic_tags":["orcs_orsinium","war_politics","history_chronicle","alchemy_crafting"],"candidate_entities":["Orichalcum","Notes","Orcs","Excavations","According","Orsinium","Gurzbog","Tamriel","Orcish","After","Elven","Gulog","Orc's","Both","High","Iron","Just","Most","I'm"],"claim_seeds":[{"evidence_sha256":"a0d214a04c26840418d297845226296f5565635835ffdbe38445049e399e4edd","evidence_preview":"Orichalcum is, to my mind, the most fascinating mineral in all of Tamriel.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"cdb35023bb3e758b744ced8324c848e076ed00fba7d10e169fd39ffc04858147","evidence_preview":"Orichalcum is green, exceptionally rigid, stronger than steel, and extremely temperamental.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"ac84cc4bb48f7c3a8f06493252b4bcd511833db2b9f635506dce6919ba5875b7","evidence_preview":"Excavations tend to be less onerous given that Orichalcum is often found in brittle shale.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"491962212efef85e5d97246ab57dc253cc93810308a704d943811810cf2899bb","evidence_preview":"Orichalcum is notoriously difficult to smelt.","promotion_status":"candidate_only_requires_review"},{"evidence_sha256":"6b077fb595e9ef9e0502d1e253b5b6e6250b3489529e4cc5e2cb002033436032","evidence_preview":"Iron is often introduced to act as a binding, but most of the Orcish smiths I spoke to dismissed the idea as evidence of laziness or lack of skill.","promotion_status":"candidate_only_requires_review"}],"review_status":"first_pass_complete_claims_unpromoted"}
