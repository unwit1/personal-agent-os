          "spooky-automod",
          "creation-kit"
        ],
        "avoid_by_default": [
          "papyrus polling",
          "native hook"
        ],
        "conditions": [
          "No runtime/load-order discovery is required."
        ]
      },
      "artifacts": [
        "plugin",
        "Spriggit source",
        "intent diff"
