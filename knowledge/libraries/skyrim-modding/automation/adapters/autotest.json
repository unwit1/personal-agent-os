{
  "schema_version": "skyrim-tool-adapter-v1",
  "adapter_id": "autotest",
  "tool": "AutoTest",
  "source": "https://github.com/Muriel-Salvan/AutoTest",
  "targets": [
    "skyrim-se"
  ],
  "capabilities": [
    "in-game-test-suite",
    "npc-screenshot-test",
    "npc-head-test",
    "cell-test",
    "json-test-queue",
    "screenshot-evidence"
  ],
  "invocation": {
    "mode": "hybrid",
    "transport": "Papyrus/in-game + external JSON",
    "requires_running_game": true
  },
  "coverage": {
    "description": "In-game automatic testing framework; current repository explicitly supports Skyrim SE.",
    "known_gaps": [
      "older Papyrus-driven architecture than devbench",
      "specialized test suites rather than a general live API"
    ],
    "denominator_probe": "Compare tests registered/requested/completed plus screenshot outputs."
  },
  "safety": {
    "mutation_default": "runtime-only",
    "supports_readback": true,
    "supports_undo": false,
    "sandbox_or_scope": "Dedicated test profile/cell; test copies rather than user save state."
  },
  "verification": {
    "independent_validators": [
      "devbench-or-runtime-state-query",
      "screenshot-vision-review"
    ],
    "version_probe": "repository/version metadata",
    "output_readback": "Test status JSON and screenshots."
  },
  "ai": {
    "typed_tooling": false,
    "schema_discovery": false,
    "provider_neutral": true,
    "context_cost_notes": "Good fixture/test-suite reference; DevBench is preferred general runtime plane."
  },
  "evidence": {
    "source_url": "https://github.com/Muriel-Salvan/AutoTest",
    "verified_date": "2026-09-24",
    "notes": "BSD-3-Clause; pushed 2026-08-09."
  }
}
