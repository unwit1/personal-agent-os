{
  "schema_version": "skyrim-tool-adapter-v1",
  "adapter_id": "vospeaker",
  "tool": "VOSpeaker",
  "source": "https://github.com/ARoese/VOSpeaker",
  "targets": [
    "skyrim-se-ae"
  ],
  "capabilities": [
    "ai-voice-generation",
    "dialogue-batch-generation",
    "pronunciation-substitution",
    "audio-import",
    "wav-conversion",
    "xwm-generation",
    "lip-generation",
    "fuz-packaging",
    "dbvo-export",
    "fomod-structured-export"
  ],
  "invocation": {
    "mode": "gui-supervised",
    "transport": "desktop application + external AI/audio backends",
    "requires_running_game": false
  },
  "coverage": {
    "description": "Skyrim voice-line project manager and AI generation/packaging pipeline.",
    "known_gaps": [
      "voice quality and rights require human review",
      "FaceFX/LIP toolchain is external/version-sensitive"
    ],
    "denominator_probe": "Track dialogue lines discovered/generated/failed/exported."
  },
  "safety": {
    "mutation_default": "new-output",
    "supports_readback": true,
    "requires_confirmation_for": [
      "public release of generated voice assets"
    ],
    "sandbox_or_scope": "Per-project output; preserve source text/audio and backend provenance."
  },
  "verification": {
    "independent_validators": [
      "spooky-audio-info",
      "fuz-extract-roundtrip",
      "game-dialogue-test"
    ],
    "version_probe": "application/repository version",
    "output_readback": "Reopen/exported line inspection and FUZ component validation."
  },
  "ai": {
    "typed_tooling": false,
    "schema_discovery": false,
    "provider_neutral": true,
    "context_cost_notes": "Useful batch voice backend; Agent OS should wrap project manifests rather than depend on UI state."
  },
  "evidence": {
    "source_url": "https://github.com/ARoese/VOSpeaker",
    "verified_date": "2026-09-24",
    "notes": "MIT; repository pushed 2026-03-30."
  }
}
