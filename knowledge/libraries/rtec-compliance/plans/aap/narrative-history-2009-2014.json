  "change_points": [
    "2010 narrative begins giving explicit placement-rate/applicant-base comparisons and prior-goal results for major job groups.",
    "2013 narrative explicitly explains an Operatives increase as transfers/demotions from job group 9, showing that job-group movement could reflect reclassification/transfer rather than external hiring.",
    "2014 narrative expands the narrative to veterans and individuals with disabilities and sets an explicit Service Workers/driver headcount growth objective from 151 to 161."
  ],
  "data_quality_boundary": [
    "All percentages are preserved exactly as printed. Several historical minority-availability/applicant-base percentages use very small percentage values and should not be silently rescaled.",
    "These narratives are annual historical interpretations, not current workforce facts or current placement goals."
