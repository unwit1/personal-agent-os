{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-mcm-helper-intent-v1.schema.json",
  "title": "Skyrim MCM Helper Config Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config",
    "settings"
  ],
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "pattern": "^[bfirSsu][^:=\\r\\n]+$"
        },
        "value": {
          "type": [
            "boolean",
            "integer",
            "number",
            "string"
          ]
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^:\\[\\]\\r\\n]+$"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "skyrim-mcm-helper-intent-v1"
    },
    "config": {
      "type": "object",
      "description": "MCM Helper config.json object; validated independently against the pinned upstream schema."
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  }
}
