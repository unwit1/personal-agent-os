{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS Improvement Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project",
    "title",
    "category",
    "status",
    "priority",
    "observation",
    "suggested_direction",
    "acceptance",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^IMP-[0-9]{4,}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "category": {
      "enum": [
        "bug",
        "performance",
        "architecture",
        "missing_test",
        "documentation",
        "skill_candidate",
        "workflow",
        "security",
        "privacy",
        "other"
      ]
    },
    "subsystem": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "ready",
        "in_progress",
        "implemented",
        "verified",
        "rejected",
        "superseded",
        "duplicate"
      ]
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "observation": {
      "type": "string",
      "minLength": 5
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suspected_root_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "suggested_direction": {
      "type": "string",
      "minLength": 3
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dedupe_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object"
    },
    "github": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
