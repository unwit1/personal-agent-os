{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-analyzer-rule-v1.schema.json",
  "title": "Skyrim Analyzer Rule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "title",
    "scope",
    "severity",
    "detection",
    "fix_policy",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-analyzer-rule-v1"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^SKYRIM-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "enum": [
        "BLOCKER",
        "ERROR",
        "WARNING",
        "INFO"
      ]
    },
    "version_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bad_pattern": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "plugin",
            "asset",
            "config",
            "papyrus",
            "native",
            "runtime-log",
            "generated-output",
            "cross-layer"
          ]
        },
        "algorithm": {
          "type": "string"
        },
        "required_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "false_positive_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fix_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "automatic",
            "proposal",
            "manual",
            "none"
          ]
        },
        "algorithm": {
          "type": "string"
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fixture_id": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "type"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "type": {
            "enum": [
              "upstream-doc",
              "upstream-source",
              "repro-test",
              "issue",
              "user-validated",
              "community"
            ]
          },
          "version": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
