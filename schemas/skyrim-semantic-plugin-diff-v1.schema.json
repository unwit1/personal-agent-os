{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-semantic-plugin-diff-v1.schema.json",
  "title": "Skyrim Semantic Plugin Diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "before",
    "after",
    "verdict",
    "comparable",
    "comparability_reasons",
    "identity",
    "coverage",
    "summary",
    "plugin_changes",
    "records_added",
    "records_removed",
    "records_changed"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-semantic-plugin-diff-v1"
    },
    "before": {
      "type": "string"
    },
    "after": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "equivalent",
        "different",
        "not-comparable"
      ]
    },
    "comparable": {
      "type": "boolean"
    },
    "comparability_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_mode",
        "after_mode",
        "before_load_order_sha256",
        "after_load_order_sha256"
      ],
      "properties": {
        "before_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "after_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "before_load_order_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "after_load_order_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "before_canonical": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "after_canonical": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records_before",
        "records_after",
        "added",
        "removed",
        "changed",
        "plugin_header_changes"
      ],
      "properties": {
        "records_before": {
          "type": "integer",
          "minimum": 0
        },
        "records_after": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "plugin_header_changes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "plugin_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "records_added": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records_removed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "changes"
        ],
        "properties": {
          "record": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "compared_fields",
        "before_only_fields",
        "after_only_fields"
      ],
      "properties": {
        "mode": {
          "enum": [
            "declared-intersection",
            "legacy-full-record"
          ]
        },
        "compared_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "before_only_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after_only_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
