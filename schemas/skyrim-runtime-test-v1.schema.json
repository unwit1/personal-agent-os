{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-runtime-test-v1.schema.json",
  "title": "Skyrim Runtime Test v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "project_id",
    "adapter",
    "fixture",
    "steps",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-runtime-test-v1"
    },
    "test_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "project_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "adapter": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "new-game",
            "save",
            "location",
            "combat",
            "quest",
            "stress",
            "custom"
          ]
        },
        "save_path": {
          "type": "string"
        },
        "cell": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destructive_copy_only": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_save_mutation": {
          "type": "boolean",
          "default": false
        },
        "allow_console_mutation": {
          "type": "boolean",
          "default": true
        },
        "allow_spawn_delete_fixtures": {
          "type": "boolean",
          "default": true
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "arguments": {
            "type": "object"
          },
          "wait_for": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 0
          },
          "capture": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "value",
              "form",
              "inventory",
              "quest",
              "event",
              "log",
              "performance",
              "screenshot",
              "health",
              "custom"
            ]
          },
          "query": {
            "type": "string"
          },
          "expected": {},
          "operator": {
            "enum": [
              "eq",
              "ne",
              "gt",
              "gte",
              "lt",
              "lte",
              "contains",
              "not_contains",
              "matches",
              "exists",
              "not_exists",
              "custom"
            ]
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "ERROR",
              "WARNING",
              "INFO"
            ],
            "default": "ERROR"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": {
          "type": "boolean",
          "default": false
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "performance": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
