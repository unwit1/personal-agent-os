{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review record",
  "type": "object",
  "required": [
    "task_id",
    "review_level",
    "status",
    "findings"
  ],
  "properties": {
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "status": {
      "enum": [
        "pass",
        "pass_with_notes",
        "changes_requested",
        "blocked",
        "disagreement"
      ]
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "findings": {
      "type": "array"
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
