{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-validation-quorum-v1.schema.json",
  "title": "Skyrim Validation Quorum v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-validation-quorum-v1"
    },
    "artifact": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "required_level": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "validator",
          "implementation_family",
          "status",
          "independent",
          "coverage"
        ],
        "properties": {
          "validator": {
            "type": "string"
          },
          "implementation_family": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warning",
              "unsupported",
              "skipped"
            ]
          },
          "independent": {
            "type": "boolean"
          },
          "semantic_fingerprint": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discovered",
              "processed",
              "skipped",
              "unclassified"
            ],
            "properties": {
              "discovered": {
                "type": "integer",
                "minimum": 0
              },
              "processed": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              },
              "unclassified": {
                "type": "integer",
                "minimum": 0
              },
              "skip_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "round_trip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-applicable",
            "not-run"
          ]
        },
        "producer": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "semantic_equivalence": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "intent_diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-applicable",
            "not-run"
          ]
        },
        "declared_touchset": {
          "type": "integer",
          "minimum": 0
        },
        "actual_touchset": {
          "type": "integer",
          "minimum": 0
        },
        "unexplained_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtime_assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-applicable",
            "not-run"
          ]
        },
        "test_id": {
          "type": "string"
        },
        "assertions_total": {
          "type": "integer",
          "minimum": 0
        },
        "assertions_passed": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
