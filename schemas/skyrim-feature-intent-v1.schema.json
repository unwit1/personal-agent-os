{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-feature-intent-v1.schema.json",
  "title": "Skyrim Feature Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "summary",
    "player_observable_behavior",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-feature-intent-v1"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "summary": {
      "type": "string"
    },
    "player_observable_behavior": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_not_happen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "target_populations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "selected_frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "selected_pattern": {
          "type": "string"
        },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "open_architecture_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_survive_save_load": {
          "type": "boolean"
        },
        "must_support_upgrade": {
          "type": "boolean"
        },
        "must_support_uninstall": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "performance_budget": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility_expectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "static",
              "runtime",
              "negative",
              "visual",
              "performance",
              "persistence",
              "compatibility",
              "packaging"
            ]
          },
          "statement": {
            "type": "string"
          },
          "automatable": {
            "type": "boolean"
          },
          "fixture_hint": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
