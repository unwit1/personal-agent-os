{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS Executive Event",
  "type": "object",
  "required": ["schema", "id", "type", "occurred_at", "source", "domain", "sensitivity", "dedup_key", "payload"],
  "properties": {
    "schema": {"const": "personal-agent/executive-event/v1"},
    "id": {"type": "string", "pattern": "^evt-[0-9a-f]{16}$"},
    "type": {
      "type": "string",
      "enum": ["conversation.completed", "idea.captured", "task.created", "task.completed", "task.deferred", "project.modified", "project.stalled", "decision.required", "decision.made", "agent.blocked", "agent.completed", "appointment.created", "appointment.approaching", "communication.received", "communication.needs_response", "preference.observed", "skill.used", "skill.failed", "outcome.recorded", "context.changed"]
    },
    "occurred_at": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "sensitivity": {
      "type": "string",
      "enum": ["public", "personal", "sensitive", "secret"]
    },
    "dedup_key": {"type": "string", "minLength": 1},
    "local_only": {"type": "boolean"},
    "subject": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "provenance": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
