{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Continuity v1",
  "type": "object",
  "required": [
    "id",
    "library_id",
    "name",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "library_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "base",
        "overlay",
        "fork",
        "adaptation",
        "project"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "extends",
              "forks_from",
              "adapts",
              "compatible_with",
              "conflicts_with",
              "supersedes"
            ]
          },
          "target": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
