{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-implementation-provider-registry-v1.schema.json",
  "title": "Skyrim Implementation Provider Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-implementation-provider-registry-v1"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "kind"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "framework",
              "strategy",
              "alias",
              "pattern",
              "reference",
              "unadapted-tool"
            ]
          },
          "adapter_id": {
            "type": "string"
          },
          "pattern_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "validation_adapters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string"
          },
          "resolves_to": {
            "type": "string"
          }
        }
      }
    }
  }
}
