{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-mod-build-report-v1.schema.json",
  "title": "Skyrim Mod Build Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_id",
    "started_at",
    "status",
    "steps",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-mod-build-report-v1"
    },
    "project_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "running",
        "passed",
        "failed",
        "needs-review",
        "cancelled"
      ]
    },
    "runtime_context": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "adapter_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "passed",
              "failed",
              "skipped",
              "needs-review"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "log_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "dry_run": {
            "type": "boolean"
          },
          "outputs_before": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "outputs_after": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "stdout_path": {
            "type": "string"
          },
          "stderr_path": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          },
          "issue_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "analyzer_rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SKYRIM-[A-Z0-9-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "status",
          "severity"
        ],
        "properties": {
          "gate": {
            "type": "string",
            "pattern": "^G[0-9]{2}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warning",
              "waived",
              "not-applicable"
            ]
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "ERROR",
              "WARNING",
              "INFO"
            ]
          },
          "tool": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "waiver": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_checks_remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "validator",
          "status"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "validator": {
            "type": "string"
          },
          "independent": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warning",
              "not-applicable"
            ]
          },
          "coverage": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disagreement": {
            "type": "string"
          }
        }
      }
    },
    "runtime_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "adapter",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warning",
              "skipped"
            ]
          },
          "assertions_total": {
            "type": "integer",
            "minimum": 0
          },
          "assertions_passed": {
            "type": "integer",
            "minimum": 0
          },
          "assertions_failed": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "denominators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "discovered",
          "processed"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "discovered": {
            "type": "integer",
            "minimum": 0
          },
          "processed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "agent_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "adapter_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "dry_run": {
            "type": "boolean"
          },
          "mutated": {
            "type": "boolean"
          },
          "readback_verified": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
