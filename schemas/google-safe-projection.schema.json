{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoogleSafeChangeProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_version", "external_key", "change_id", "captured_at", "updated_at", "change_type", "status", "project_id", "project_confidence", "safe_title", "safe_request_summary", "reusable_candidate", "source_kind", "agent_os_ingested", "export_policy_version"],
  "properties": {
    "projection_version": {"const": 1},
    "external_key": {"type": "string", "minLength": 12, "maxLength": 64},
    "change_id": {"type": "string"},
    "captured_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "change_type": {"type": "string"},
    "status": {"type": "string"},
    "project_id": {"type": "string"},
    "project_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "safe_title": {"type": "string", "maxLength": 180},
    "safe_request_summary": {"type": "string", "maxLength": 1200},
    "safe_diagnosis_summary": {"type": ["string", "null"], "maxLength": 1200},
    "safe_fix_summary": {"type": ["string", "null"], "maxLength": 1200},
    "safe_validation_summary": {"type": ["string", "null"], "maxLength": 800},
    "reusable_candidate": {"type": "boolean"},
    "source_kind": {"enum": ["chat", "agent", "issue", "manual", "import"]},
    "agent_os_ingested": {"type": "boolean"},
    "canonical_ref": {"type": ["string", "null"]},
    "export_policy_version": {"type": "string"}
  }
}
