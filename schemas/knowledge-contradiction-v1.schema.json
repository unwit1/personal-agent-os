{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Contradiction v1",
  "type": "object",
  "required": [
    "id",
    "library_id",
    "claim_ids",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "library_id": {
      "type": "string"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolution": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
