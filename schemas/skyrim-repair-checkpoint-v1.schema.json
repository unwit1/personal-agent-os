{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-repair-checkpoint-v1.schema.json",
  "title": "Skyrim Mod Factory Repair Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repair_id",
    "project_id",
    "created_at",
    "execution_state_path",
    "invalidated_nodes",
    "prior_nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-repair-checkpoint-v1"
    },
    "repair_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "build_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_state_path": {
      "type": "string"
    },
    "invalidated_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "prior_nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "output_backups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "backup_path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "backup_path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
