{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtec-hr-knowledge-v1.schema.json",
  "title": "RTEC HR knowledge record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "status",
    "claims",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "enum": [
        "process",
        "policy",
        "form",
        "system",
        "role",
        "exception",
        "question",
        "automation_candidate",
        "decision_rule"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "extracted",
        "candidate",
        "validated",
        "canonical",
        "conflicted",
        "superseded",
        "case_only",
        "rejected"
      ]
    },
    "summary": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "confidence",
          "evidence"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "claim_kind": {
            "type": "string",
            "enum": [
              "observed_fact",
              "interpretation",
              "rule_candidate",
              "canonical_rule"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "relationship": {
            "type": "string",
            "enum": [
              "NEW",
              "DUPLICATE",
              "EXTENDS",
              "CONFLICTS_WITH",
              "DEPENDS_ON",
              "SUPERSEDES"
            ]
          },
          "related_record_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "page_or_section": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_type": {
                  "type": "string",
                  "enum": [
                    "explicit_text",
                    "structural",
                    "repeated_observation",
                    "user_clarification"
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deadlines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "automation_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "ingested_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "safe_source_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_date_or_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "page_or_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "ingested_at": {
            "type": "string"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_created_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_revision_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_effective_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_effective_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "temporal_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "current",
              "historical",
              "superseded",
              "future_effective",
              "unknown",
              "conflicting",
              null
            ]
          },
          "full_source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "searchable_text_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "temporal_status": {
      "type": "string",
      "enum": [
        "current",
        "historical",
        "superseded",
        "future_effective",
        "unknown",
        "conflicting"
      ]
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
