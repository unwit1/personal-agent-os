{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-runtime-worker-config-v1.schema.json",
  "title": "Skyrim Runtime Worker Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_id",
    "platform",
    "mo2",
    "profiles",
    "workspace",
    "process_policy",
    "timeouts"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-runtime-worker-config-v1"
    },
    "worker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "platform": {
      "const": "windows"
    },
    "mo2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "configured_executable"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "instance": {
          "type": [
            "string",
            "null"
          ]
        },
        "configured_executable": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_dir",
        "disposable_root",
        "profile_name_prefix"
      ],
      "properties": {
        "template_dir": {
          "type": "string",
          "minLength": 1
        },
        "disposable_root": {
          "type": "string",
          "minLength": 1
        },
        "profile_name_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "copy_ignores": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_root",
        "evidence_root"
      ],
      "properties": {
        "run_root": {
          "type": "string",
          "minLength": 1
        },
        "evidence_root": {
          "type": "string",
          "minLength": 1
        },
        "allowed_mutation_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "fixture_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "save_target_relative": {
          "type": "string",
          "default": "saves"
        },
        "require_fresh_copy": {
          "type": "boolean",
          "default": true
        },
        "delete_disposable_profile_on_success": {
          "type": "boolean",
          "default": true
        },
        "retain_on_failure": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "process_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusive_process_names"
      ],
      "properties": {
        "exclusive_process_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reject_existing_mo2_instance": {
          "type": "boolean",
          "default": true
        },
        "session_game_executables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allow_force_kill_session_game": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "crash_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "screenshot_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame_trace_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden_log_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "complete_for_g19": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_seconds",
        "scenario_seconds",
        "shutdown_seconds"
      ],
      "properties": {
        "launch_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "scenario_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "shutdown_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "performance_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "executable"
      ],
      "properties": {
        "provider": {
          "const": "presentmon"
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "timed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "required_when_requested": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
