{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS Executive Entity",
  "type": "object",
  "required": ["schema", "id", "kind", "title", "status", "created_at", "updated_at", "source", "domain", "sensitivity", "provenance"],
  "properties": {
    "schema": {"const": "personal-agent/executive-entity/v1"},
    "id": {"type": "string", "pattern": "^ex-[a-z_]+-[0-9a-f]{16}$"},
    "kind": {
      "type": "string",
      "enum": ["task", "commitment", "project", "next_action", "blocker", "waiting_on", "decision_request", "question", "idea", "appointment", "communication", "attention_state", "outcome"]
    },
    "title": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["open", "active", "waiting", "deferred", "done", "cancelled", "superseded"]
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "last_confirmed": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "sensitivity": {
      "type": "string",
      "enum": ["public", "personal", "sensitive", "secret"]
    },
    "local_only": {"type": "boolean"},
    "provenance": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "superseded_by": {"type": ["string", "null"]},
    "refs": {"type": "array", "items": {"type": "string"}},
    "attributes": {"type": "object"}
  },
  "additionalProperties": true
}
