{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Claim v1",
  "type": "object",
  "required": [
    "id",
    "library_id",
    "subject_id",
    "predicate",
    "object",
    "citations"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "library_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object": {},
    "qualifiers": {
      "type": "object"
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "asserted",
        "disputed",
        "superseded",
        "overlay"
      ]
    }
  },
  "additionalProperties": false
}
