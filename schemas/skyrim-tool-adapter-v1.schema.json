{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-tool-adapter-v1.schema.json",
  "title": "Skyrim Tool Adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "tool",
    "capabilities",
    "invocation",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-tool-adapter-v1"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "cli",
            "library",
            "gui-supervised",
            "hybrid",
            "mcp-stdio",
            "mcp-http",
            "rest",
            "named-pipe",
            "in-process-api"
          ]
        },
        "executable": {
          "type": "string"
        },
        "arguments_template": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "working_directory": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "endpoint": {
          "type": "string"
        },
        "transport": {
          "type": "string"
        },
        "health_probe": {
          "type": "string"
        },
        "requires_running_game": {
          "type": "boolean",
          "default": false
        },
        "requires_mo2_context": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_codes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "required_output_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_log_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safe": {
          "type": "boolean"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "cleanup_outputs_first": {
          "type": "boolean"
        }
      }
    },
    "auto_fixable_issue_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "destructive_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "verified_date"
      ],
      "properties": {
        "source_url": {
          "type": "string"
        },
        "verified_date": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_types": {
          "type": "integer",
          "minimum": 0
        },
        "api_entries": {
          "type": "integer",
          "minimum": 0
        },
        "tools": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denominator_probe": {
          "type": "string"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mutation_default": {
          "enum": [
            "read-only",
            "dry-run",
            "new-output",
            "in-place",
            "runtime-only",
            "mixed"
          ]
        },
        "supports_dry_run": {
          "type": "boolean"
        },
        "supports_readback": {
          "type": "boolean"
        },
        "supports_undo": {
          "type": "boolean"
        },
        "requires_confirmation_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sandbox_or_scope": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "independent_validators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version_probe": {
          "type": "string"
        },
        "output_readback": {
          "type": "string"
        },
        "mutation_test_fixture": {
          "type": "string"
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typed_tooling": {
          "type": "boolean"
        },
        "schema_discovery": {
          "type": "boolean"
        },
        "provider_neutral": {
          "type": "boolean"
        },
        "tool_count": {
          "type": "integer",
          "minimum": 0
        },
        "context_cost_notes": {
          "type": "string"
        }
      }
    }
  }
}
