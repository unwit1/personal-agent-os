{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable memory record",
  "type": "object",
  "required": ["id", "scope", "type", "statement", "status", "provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "type": {"enum": ["decision", "lesson", "preference", "reference"]},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "verified", "durable", "deprecated"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "superseded_by": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
