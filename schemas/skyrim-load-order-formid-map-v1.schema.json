{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-load-order-formid-map-v1.schema.json",
  "title": "Skyrim Load Order FormID Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "full",
    "light"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-load-order-formid-map-v1"
    },
    "full": {
      "type": "object",
      "patternProperties": {
        "^[0-9A-Fa-f]{2}$": {
          "type": "string",
          "pattern": "^.+\\.(?:esm|esp|esl)$"
        }
      },
      "additionalProperties": false
    },
    "light": {
      "type": "object",
      "patternProperties": {
        "^[0-9A-Fa-f]{3}$": {
          "type": "string",
          "pattern": "^.+\\.(?:esm|esp|esl)$"
        }
      },
      "additionalProperties": false
    }
  }
}
