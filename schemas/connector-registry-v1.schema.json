{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS connector registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "connectors"],
  "properties": {
    "schema": {"const": "personal-agent/connector-registry/v1"},
    "version": {"const": 1},
    "connectors": {
      "type": "array",
      "items": {"$ref": "#/$defs/connector"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 100},
    "scope": {"type": "string", "minLength": 1, "maxLength": 160},
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "capabilities", "scopes", "health", "privacy_domain", "registrations", "secret_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"},
            "name": {"$ref": "#/$defs/label"}
          }
        },
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "scopes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}},
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checked_at"],
          "properties": {
            "status": {"enum": ["unknown", "healthy", "degraded", "unavailable"]},
            "checked_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "privacy_domain": {"$ref": "#/$defs/identifier"},
        "registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface_id", "state"],
            "properties": {
              "surface_id": {"$ref": "#/$defs/identifier"},
              "state": {"enum": ["desired", "registered", "disabled", "unsupported", "error"]}
            }
          }
        },
        "secret_ref": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(keyring|windows-credential|macos-keychain|secret-service|env):[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"}
          ]
        }
      }
    }
  }
}
