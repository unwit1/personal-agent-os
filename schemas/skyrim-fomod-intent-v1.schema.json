{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-fomod-intent-v1.schema.json",
  "title": "Skyrim FOMOD Installer Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "module"
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "fileItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "folder"
          ]
        },
        "source": {
          "$ref": "#/$defs/path"
        },
        "destination": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/path"
            }
          ]
        },
        "always_install": {
          "type": "boolean",
          "default": false
        },
        "install_if_usable": {
          "type": "boolean",
          "default": false
        },
        "priority": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "dependency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "file",
            "state"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "Missing",
                "Inactive",
                "Active"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "flag",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "flag"
            },
            "flag": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version"
          ],
          "properties": {
            "kind": {
              "enum": [
                "game",
                "fomm"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operator",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "group"
            },
            "operator": {
              "enum": [
                "And",
                "Or"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/dependency"
              }
            }
          }
        }
      ]
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/path"
        },
        "type": {
          "enum": [
            "Required",
            "Optional",
            "Recommended",
            "NotUsable",
            "CouldBeUsable"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileItem"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "files"
              ],
              "properties": {
                "files": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "flags"
              ],
              "properties": {
                "flags": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "options"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "SelectAtLeastOne",
            "SelectAtMostOne",
            "SelectExactlyOne",
            "SelectAll",
            "SelectAny"
          ]
        },
        "order": {
          "enum": [
            "Ascending",
            "Descending",
            "Explicit"
          ],
          "default": "Explicit"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "groups"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visible": {
          "$ref": "#/$defs/dependency"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "conditionalInstall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencies",
        "files"
      ],
      "properties": {
        "dependencies": {
          "$ref": "#/$defs/dependency"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileItem"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "skyrim-fomod-intent-v1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "author",
        "version",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "machine_version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title_position": {
          "enum": [
            "Left",
            "Right",
            "RightOfImage"
          ],
          "default": "Left"
        },
        "title_colour": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$",
          "default": "000000"
        },
        "image": {
          "$ref": "#/$defs/path"
        },
        "image_show": {
          "type": "boolean",
          "default": true
        },
        "image_fade": {
          "type": "boolean",
          "default": true
        },
        "image_height": {
          "type": "integer",
          "default": -1
        },
        "dependencies": {
          "$ref": "#/$defs/dependency"
        },
        "required_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileItem"
          }
        },
        "steps_order": {
          "enum": [
            "Ascending",
            "Descending",
            "Explicit"
          ],
          "default": "Explicit"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "conditional_installs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conditionalInstall"
          }
        }
      }
    }
  }
}
