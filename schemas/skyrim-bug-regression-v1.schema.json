{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-bug-regression-v1.schema.json",
  "title": "Skyrim Bug Regression Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bug_id",
    "project_id",
    "status",
    "symptom",
    "environment",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-bug-regression-v1"
    },
    "bug_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "project_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "reported",
        "reproduced",
        "root-caused",
        "fixed",
        "validated",
        "closed"
      ]
    },
    "symptom": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "reproduction": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_causal_error": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "layer": {
      "type": "string"
    },
    "fixed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "type": "string"
        },
        "test_id": {
          "type": "string"
        },
        "analyzer_rule_id": {
          "type": "string"
        },
        "mutation_test": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failing_task": {
      "type": "string"
    },
    "adapter": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
