{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-execution-context-v1.schema.json",
  "title": "Skyrim Mod Factory Execution Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-execution-context-v1"
    },
    "project_id": {
      "type": "string"
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "variables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adapter_order": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "artifact_contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "validator"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "validator": {
                  "enum": [
                    "json-schema"
                  ]
                },
                "schema": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+\\.schema\\.json$"
                },
                "required": {
                  "type": "boolean",
                  "default": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "validator": {
                        "const": "json-schema"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "schema"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stop_on_failure": {
          "type": "boolean",
          "default": true
        },
        "continue_on_needs_review": {
          "type": "boolean",
          "default": false
        },
        "allow_safe_retry": {
          "type": "boolean",
          "default": true
        },
        "allow_cleanup_outputs": {
          "type": "boolean",
          "default": false
        },
        "max_attempts_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        }
      }
    }
  }
}
