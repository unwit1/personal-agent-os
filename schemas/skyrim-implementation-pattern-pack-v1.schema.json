{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-implementation-pattern-pack-v1.schema.json",
  "title": "Skyrim Implementation Pattern Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "patterns"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-implementation-pattern-pack-v1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "skyrim-implementation-pattern-v1.schema.json"
      }
    }
  }
}
