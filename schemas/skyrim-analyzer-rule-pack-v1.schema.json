{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-analyzer-rule-pack-v1.schema.json",
  "title": "Skyrim Analyzer Rule Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-analyzer-rule-pack-v1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "skyrim-analyzer-rule-v1.schema.json"
      }
    }
  }
}
