{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-agent/executive-queue-item/v1",
  "title": "Agent OS Executive Queue Item",
  "type": "object",
  "required": ["schema", "id", "entity_id", "queued_at", "source", "domain", "sensitivity"],
  "properties": {
    "schema": {"const": "personal-agent/executive-queue-item/v1"},
    "id": {"type": "string", "pattern": "^qi-[0-9a-f]{16}$"},
    "entity_id": {"type": "string", "pattern": "^ex-[a-z_]+-[0-9a-f]{16}$"},
    "queued_at": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "sensitivity": {
      "type": "string",
      "enum": ["public", "personal", "sensitive", "secret"]
    },
    "priority": {"type": ["number", "null"], "minimum": 0},
    "urgency": {"type": ["string", "null"], "enum": ["critical", "high", "normal", "low", null]},
    "deadline": {"type": ["string", "null"]},
    "importance": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "estimated_effort": {"type": ["string", "null"]},
    "blocking_impact": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "waiting_on": {"type": ["string", "null"]},
    "repeated_deferrals": {"type": ["integer", "null"], "minimum": 0},
    "interruption_cost": {"type": ["number", "null"], "minimum": 0},
    "user_priority": {"type": ["string", "null"]},
    "status": {
      "type": "string",
      "enum": ["queued", "presented", "accepted", "rejected", "deferred", "completed", "cancelled"]
    },
    "reason": {"type": ["string", "null"]},
    "provenance": {"type": "array", "items": {"type": "string"}},
    "local_only": {"type": "boolean"},
    "metadata": {"type": "object"},
    "additionalProperties": true
  }
}
