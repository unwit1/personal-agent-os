{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-implementation-pattern-v1.schema.json",
  "title": "Skyrim Implementation Pattern v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pattern_id",
    "intent",
    "preferred_layers",
    "selection",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-implementation-pattern-v1"
    },
    "pattern_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "intent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "preferred_layers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred"
      ],
      "properties": {
        "preferred": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid_by_default": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preemptive_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gates"
      ],
      "properties": {
        "gates": {
          "type": "array",
          "items": {
            "pattern": "^G[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "runtime_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compatibility_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
