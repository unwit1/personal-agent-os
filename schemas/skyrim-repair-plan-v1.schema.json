{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-repair-plan-v1.schema.json",
  "title": "Skyrim Mod Factory Repair Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repair_id",
    "project_id",
    "failure",
    "classification",
    "hypotheses",
    "policy",
    "validation",
    "rollback"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-repair-plan-v1"
    },
    "repair_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "project_id": {
      "type": "string"
    },
    "build_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bug_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "first_causal_error": {
          "type": "string"
        },
        "issue_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "failing_task": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "output_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "failure_kind",
        "confidence"
      ],
      "properties": {
        "layer": {
          "type": "string"
        },
        "failure_kind": {
          "enum": [
            "deterministic-code",
            "schema",
            "dependency",
            "toolchain",
            "runtime",
            "asset",
            "generated-output",
            "save-state",
            "performance",
            "integration",
            "environment",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "matched_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cause",
          "rank",
          "supporting_evidence",
          "contradicting_evidence",
          "test"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "cause": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ]
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradicting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "expected_if_true",
              "expected_if_false"
            ],
            "properties": {
              "action": {
                "type": "string"
              },
              "adapter": {
                "type": "string"
              },
              "expected_if_true": {
                "type": "string"
              },
              "expected_if_false": {
                "type": "string"
              },
              "cost": {
                "enum": [
                  "trivial",
                  "low",
                  "medium",
                  "high"
                ]
              },
              "destructive": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason",
        "reversible",
        "postconditions_provable"
      ],
      "properties": {
        "mode": {
          "enum": [
            "automatic",
            "proposal",
            "manual",
            "forbidden"
          ]
        },
        "reason": {
          "type": "string"
        },
        "reversible": {
          "type": "boolean"
        },
        "postconditions_provable": {
          "type": "boolean"
        },
        "requires_user_decision": {
          "type": "boolean"
        },
        "decision_reason": {
          "type": "string"
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_hypothesis": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "mutates",
              "scope"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "adapter": {
                "type": "string"
              },
              "mutates": {
                "type": "boolean"
              },
              "scope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "safe_retry": {
                "type": "boolean"
              },
              "expected_outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "handler_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            }
          }
        },
        "downstream_invalidations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preconditions",
        "postconditions",
        "independent_validators",
        "regression_tests"
      ],
      "properties": {
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independent_validators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtime_assertions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regression_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mutation_test": {
          "type": "string"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "checkpoint_required"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "checkpoint_required": {
          "type": "boolean"
        },
        "checkpoint": {
          "type": "string"
        },
        "bad_fix_rollback_automatic": {
          "type": "boolean"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "planned",
            "testing",
            "repaired",
            "failed",
            "rolled-back",
            "decision-required",
            "escalated"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_issue_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regression_promoted": {
          "type": "boolean"
        }
      }
    }
  }
}
