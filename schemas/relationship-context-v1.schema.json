{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized relationship context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "purpose",
    "durable_relationship_context",
    "source_attribution_policy",
    "quarantined_or_unresolved",
    "unresolved_identity_candidates",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "durable_relationship_context": {
      "type": "object",
      "additionalProperties": true
    },
    "source_attribution_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "quarantined_or_unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "reason",
          "promotion_rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "promotion_rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved_identity_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "domain",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^candidate:[a-z0-9._-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "personal",
              "work",
              "education",
              "cross-domain"
            ]
          },
          "status": {
            "type": "string",
            "pattern": "^candidate"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source",
          "status",
          "note"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
