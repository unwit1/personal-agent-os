{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-quality-plan-v1.schema.json",
  "title": "Skyrim Mod Factory Quality Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "risk_tier",
    "gates",
    "adapters",
    "static_checks",
    "runtime_scenarios",
    "mutation_tests",
    "human_checks",
    "invalidation_triggers",
    "blocking_questions",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-quality-plan-v1"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "pattern": "^G[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred",
        "supporting"
      ],
      "properties": {
        "preferred": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "supporting": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "static_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtime_scenarios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mutation_tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "human_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "invalidation_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "blocking_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "selected_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "framework_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "strategy_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reference_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unadapted_providers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provider_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "pattern_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "implementation_providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "kind",
          "preference"
        ],
        "properties": {
          "provider_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "preference": {
            "enum": [
              "preferred",
              "alternative"
            ]
          },
          "resolved_adapter": {
            "type": "string"
          }
        }
      }
    }
  }
}
