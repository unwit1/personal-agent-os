{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-runtime-patch-intent-v1.schema.json",
  "title": "Skyrim Runtime Patch Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "framework",
    "grammar_source",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-runtime-patch-intent-v1"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "framework": {
      "enum": [
        "spid",
        "kid",
        "bos",
        "flm",
        "skypatcher",
        "oar"
      ]
    },
    "framework_version": {
      "type": "string"
    },
    "grammar_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "snapshot"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "output_file": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/spidEntry"
          },
          {
            "$ref": "#/$defs/kidEntry"
          },
          {
            "$ref": "#/$defs/bosEntry"
          },
          {
            "$ref": "#/$defs/genericEntry"
          }
        ]
      }
    }
  },
  "$defs": {
    "formRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editor_id": {
          "type": "string",
          "minLength": 1
        },
        "form_id": {
          "type": "string",
          "pattern": "^0[xX][0-9A-Fa-f]+$"
        },
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "dynamic_keyword": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "editor_id"
          ]
        },
        {
          "required": [
            "form_id",
            "plugin"
          ]
        },
        {
          "required": [
            "dynamic_keyword"
          ]
        }
      ]
    },
    "spidEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "form"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Spell",
            "Perk",
            "Item",
            "Shout",
            "Package",
            "Keyword",
            "Outfit",
            "SleepOutfit",
            "Faction",
            "Skin",
            "Form"
          ]
        },
        "form": {
          "$ref": "#/$defs/formRef"
        },
        "string_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "form_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "level_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trait_filter": {
          "type": "string"
        },
        "count_or_package_index": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0
        },
        "chance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "percent"
          ],
          "properties": {
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "deterministic": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "genericEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^Generic[A-Za-z0-9._-]*$",
          "description": "Reserved future/untyped entry kind. Specialized SPID/KID/BOS entries must use their dedicated schemas."
        },
        "semantic_action": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "kidEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "keyword",
        "target_type"
      ],
      "properties": {
        "kind": {
          "const": "KIDKeyword"
        },
        "keyword": {
          "$ref": "#/$defs/formRef"
        },
        "target_type": {
          "enum": [
            "Armor",
            "Weapon",
            "Ammo",
            "Magic Effect",
            "Potion",
            "Scroll",
            "Location",
            "Ingredient",
            "Book",
            "Misc Item",
            "Key",
            "Soul Gem",
            "Spell",
            "Activator",
            "Flora",
            "Furniture",
            "Race",
            "Talking Activator",
            "Enchantment"
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traits": {
          "type": "string"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "bosEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base",
        "swap"
      ],
      "properties": {
        "kind": {
          "const": "BOSFormSwap"
        },
        "base": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formRef"
          }
        },
        "swap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formRef"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties_raw": {
          "type": "string"
        },
        "chance_raw": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    }
  }
}
