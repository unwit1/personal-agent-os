{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/skyrim-runtime-patch-intent-v1.schema.json",
  "title": "Skyrim Runtime Patch Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "framework",
    "grammar_source",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "skyrim-runtime-patch-intent-v1"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "framework": {
      "enum": [
        "spid",
        "kid",
        "bos",
        "flm",
        "skypatcher",
        "oar"
      ]
    },
    "framework_version": {
      "type": "string"
    },
    "grammar_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "snapshot"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "output_file": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/spidEntry"
          },
          {
            "$ref": "#/$defs/kidEntry"
          },
          {
            "$ref": "#/$defs/bosEntry"
          },
          {
            "$ref": "#/$defs/flmEntry"
          },
          {
            "$ref": "#/$defs/oarEntry"
          },
          {
            "$ref": "#/$defs/genericEntry"
          }
        ]
      }
    },
    "oar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "formRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editor_id": {
          "type": "string",
          "minLength": 1
        },
        "form_id": {
          "type": "string",
          "pattern": "^0[xX][0-9A-Fa-f]+$"
        },
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "dynamic_keyword": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "editor_id"
          ]
        },
        {
          "required": [
            "form_id",
            "plugin"
          ]
        },
        {
          "required": [
            "dynamic_keyword"
          ]
        }
      ]
    },
    "spidEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "form"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Spell",
            "Perk",
            "Item",
            "Shout",
            "Package",
            "Keyword",
            "Outfit",
            "SleepOutfit",
            "Faction",
            "Skin",
            "Form"
          ]
        },
        "form": {
          "$ref": "#/$defs/formRef"
        },
        "string_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "form_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "level_filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trait_filter": {
          "type": "string"
        },
        "count_or_package_index": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0
        },
        "chance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "percent"
          ],
          "properties": {
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "deterministic": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "genericEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^Generic[A-Za-z0-9._-]*$",
          "description": "Reserved future/untyped entry kind. Specialized SPID/KID/BOS entries must use their dedicated schemas."
        },
        "semantic_action": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "kidEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "keyword",
        "target_type"
      ],
      "properties": {
        "kind": {
          "const": "KIDKeyword"
        },
        "keyword": {
          "$ref": "#/$defs/formRef"
        },
        "target_type": {
          "enum": [
            "Armor",
            "Weapon",
            "Ammo",
            "Magic Effect",
            "Potion",
            "Scroll",
            "Location",
            "Ingredient",
            "Book",
            "Misc Item",
            "Key",
            "Soul Gem",
            "Spell",
            "Activator",
            "Flora",
            "Furniture",
            "Race",
            "Talking Activator",
            "Enchantment"
          ]
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traits": {
          "type": "string"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "bosEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base",
        "swap"
      ],
      "properties": {
        "kind": {
          "const": "BOSFormSwap"
        },
        "base": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formRef"
          }
        },
        "swap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/formRef"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties_raw": {
          "type": "string"
        },
        "chance_raw": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "flmFilter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "conditions"
          ]
        }
      ]
    },
    "flmMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "form",
            "formlist_contents",
            "group",
            "collection"
          ]
        },
        "form": {
          "$ref": "#/$defs/formRef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "form",
                  "formlist_contents"
                ]
              }
            }
          },
          "then": {
            "required": [
              "form"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "group",
                  "collection"
                ]
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        }
      ]
    },
    "flmListTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "formlist",
            "alias"
          ]
        },
        "form": {
          "$ref": "#/$defs/formRef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "formlist"
              }
            }
          },
          "then": {
            "required": [
              "form"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "alias"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        }
      ]
    },
    "flmKeyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form"
      ],
      "properties": {
        "form": {
          "$ref": "#/$defs/formRef"
        },
        "exclude": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "flmEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "conditions"
          ],
          "properties": {
            "kind": {
              "const": "FLMFilter"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "comment": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "formlists"
          ],
          "properties": {
            "kind": {
              "const": "FLMAlias"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "formlists": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/formRef"
              }
            },
            "comment": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "FLMGroup"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/flmMember"
              }
            },
            "comment": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "form_type",
            "keywords"
          ],
          "properties": {
            "kind": {
              "const": "FLMCollection"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "form_type": {
              "enum": [
                "Armor",
                "Weapon",
                "Ammo",
                "MagicEffect",
                "AlchemyItem",
                "Scroll",
                "Location",
                "Ingredient",
                "Book",
                "Misc",
                "Key",
                "Soulgem",
                "Activator",
                "Flora",
                "Furniture",
                "Race",
                "TalkingActivator",
                "Enchantment",
                "NPC",
                "Spell"
              ]
            },
            "keywords": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/flmKeyword"
              }
            },
            "filter": {
              "$ref": "#/$defs/flmFilter"
            },
            "comment": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "FLMFormList"
            },
            "target": {
              "$ref": "#/$defs/flmListTarget"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/flmMember"
              }
            },
            "filter": {
              "$ref": "#/$defs/flmFilter"
            },
            "comment": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "event_name",
            "target",
            "members"
          ],
          "properties": {
            "kind": {
              "const": "FLMModEvent"
            },
            "event_name": {
              "type": "string",
              "pattern": "^[A-Za-z]+$"
            },
            "target": {
              "$ref": "#/$defs/flmListTarget"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/flmMember"
              }
            },
            "comment": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "first",
            "second"
          ],
          "properties": {
            "kind": {
              "enum": [
                "FLMPlant",
                "FLMAtronachForge",
                "FLMAtronachForgeSigil",
                "FLMDragonbornSpiderCrafting"
              ]
            },
            "first": {
              "$ref": "#/$defs/formRef"
            },
            "second": {
              "$ref": "#/$defs/formRef"
            },
            "filter": {
              "$ref": "#/$defs/flmFilter"
            },
            "comment": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "members"
          ],
          "properties": {
            "kind": {
              "enum": [
                "FLMBToys",
                "FLMGToys",
                "FLMHairColors"
              ]
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/flmMember"
              }
            },
            "filter": {
              "$ref": "#/$defs/flmFilter"
            },
            "comment": {
              "type": "string"
            }
          }
        }
      ]
    },
    "oarCondition": {
      "type": "object",
      "required": [
        "condition"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "description": "Source-shaped OAR condition object. The condition discriminator is typed; condition-specific arguments remain upstream-shaped until provider-specific schemas are added."
    },
    "oarEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "directory",
        "name",
        "priority",
        "conditions"
      ],
      "properties": {
        "kind": {
          "const": "OARSubmod"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\\\.\\\\.(?:[\\\\/]|$)).+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "disabled": {
          "type": "boolean"
        },
        "override_animations_folder": {
          "type": "string",
          "minLength": 1
        },
        "required_behavior_project_name": {
          "type": "string",
          "minLength": 1
        },
        "interruptible": {
          "type": "boolean"
        },
        "replace_on_loop": {
          "type": "boolean"
        },
        "replace_on_echo": {
          "type": "boolean"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oarCondition"
          }
        },
        "paired_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oarCondition"
          }
        },
        "comment": {
          "type": "string"
        }
      }
    }
  }
}
