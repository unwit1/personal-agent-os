{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-agent/evidence-record/v1",
  "title": "Orchestrator OS typed evidence record",
  "description": "One schema for every typed record in the improvement evidence chain (docs/orchestrator-os/CONSTITUTION.md §8). IMP keeps schemas/improvement.schema.json; CAP records are generated by orchestrator/capability.py. Records link with typed edges instead of duplicating content. Raw traces stay machine-local; records carry references only.",
  "type": "object",
  "required": ["schema", "id", "type", "title", "status", "created_at"],
  "properties": {
    "schema": {"const": "personal-agent/evidence-record/v1"},
    "id": {"type": "string", "pattern": "^(OBS|CLM|FND|FAIL|SUC|HYP|EXP|EVC|EVS|EVR|DEC|REL|CAP|RAD|Q)-[0-9A-Za-z-]{4,}$"},
    "type": {"enum": ["OBS", "CLM", "FND", "FAIL", "SUC", "HYP", "EXP", "EVC", "EVS", "EVR", "DEC", "REL", "CAP", "RAD", "Q"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "status": {"enum": ["active", "open", "proposed", "accepted", "rejected", "inconclusive", "superseded", "resolved", "promoted", "rolled_back", "draft"]},
    "summary": {"type": "string"},
    "key": {"type": "object", "description": "CAP: task_family, role, provider, model_resolved, effort, toolset. FAIL/SUC: signature fields."},
    "metrics": {"type": "object", "description": "Separate dimensions; never a single blended score."},
    "outcome": {"enum": ["improved", "noninferior", "regressed", "inconclusive", "rejected", "n/a"]},
    "signature": {"type": "string", "description": "FAIL/SUC: normalized, stable recurrence signature."},
    "recurrence": {"type": "integer", "minimum": 0},
    "task_family": {"type": "string"},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "ref"],
        "properties": {
          "rel": {"enum": ["evidence_for", "evidence_against", "derived_from", "tests", "measures", "decides", "implements", "supersedes", "blocks", "answers", "relates_to", "rolls_back", "baseline", "candidate"]},
          "ref": {"type": "string", "description": "Record id (IMP-0003, EXP-0001, MIE-0002), repo path, commit:<sha>, or local:<machine-local ref>."}
        }
      }
    },
    "provenance": {"type": "object"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
